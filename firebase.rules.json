        ".write": "auth != null && ((root.child('admins').child(auth.uid).val() === true || root.child('users').child(auth.uid).child('role').val() === 'Хост' || root.child('users').child(auth.uid).child('role').val() === 'Фаундер' || root.child('users').child(auth.uid).child('role').val() === 'IT') || (auth.uid === $uid && ((!data.exists() && newData.child('role').val() === 'Участник' && newData.child('status').val() === 'pending' && newData.child('warnings').val() === 0 && !newData.child('discipline').exists()) || (data.exists() && newData.child('role').val() === data.child('role').val() && newData.child('status').val() === data.child('status').val() && newData.child('warnings').val() === data.child('warnings').val() && newData.child('discipline').val() === data.child('discipline').val()))))"
      }
    },
    "flights": {
