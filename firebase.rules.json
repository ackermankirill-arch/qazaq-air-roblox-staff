        },
        "date": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('users').child(auth.uid).child('role').val() === 'Хост' || root.child('users').child(auth.uid).child('role').val() === 'Фаундер' || root.child('users').child(auth.uid).child('role').val() === 'IT')"
        },
        "role": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('users').child(auth.uid).child('role').val() === 'Хост' || root.child('users').child(auth.uid).child('role').val() === 'Фаундер' || root.child('users').child(auth.uid).child('role').val() === 'IT')"
        },
        "capacity": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('users').child(auth.uid).child('role').val() === 'Хост' || root.child('users').child(auth.uid).child('role').val() === 'Фаундер' || root.child('users').child(auth.uid).child('role').val() === 'IT')"
        },
        "description": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('users').child(auth.uid).child('role').val() === 'Хост' || root.child('users').child(auth.uid).child('role').val() === 'Фаундер' || root.child('users').child(auth.uid).child('role').val() === 'IT')"
        },
        "status": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('users').child(auth.uid).child('role').val() === 'Хост' || root.child('users').child(auth.uid).child('role').val() === 'Фаундер' || root.child('users').child(auth.uid).child('role').val() === 'IT')"
        },
        "createdAt": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('users').child(auth.uid).child('role').val() === 'Хост' || root.child('users').child(auth.uid).child('role').val() === 'Фаундер' || root.child('users').child(auth.uid).child('role').val() === 'IT')"
        },
        "createdBy": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('users').child(auth.uid).child('role').val() === 'Хост' || root.child('users').child(auth.uid).child('role').val() === 'Фаундер' || root.child('users').child(auth.uid).child('role').val() === 'IT')"
        },
        "registrations": {
          "$uid": {
            ".write": "auth != null && (((root.child('admins').child(auth.uid).val() === true || root.child('users').child(auth.uid).child('role').val() === 'Хост' || root.child('users').child(auth.uid).child('role').val() === 'Фаундер' || root.child('users').child(auth.uid).child('role').val() === 'IT')) || (auth.uid === $uid && root.child('users').child(auth.uid).child('status').val() === 'approved' && root.child('flights').child($flightId).child('status').val() === 'open' && !data.exists()))",
            ".validate": "((root.child('admins').child(auth.uid).val() === true || root.child('users').child(auth.uid).child('role').val() === 'Хост' || root.child('users').child(auth.uid).child('role').val() === 'Фаундер' || root.child('users').child(auth.uid).child('role').val() === 'IT')) || newData.child('uid').val() === auth.uid"
